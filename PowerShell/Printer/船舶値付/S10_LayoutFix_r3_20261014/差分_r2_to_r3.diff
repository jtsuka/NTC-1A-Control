+# 2026-10-14 r3: 全角・半角カナを含む文字列を、欄からはみ出して文字が欠けないように描画する。
+# 2026-10-14 E266083660 の発注先「住友重機械工業 株式会社 DT-SBU 関西営業部大阪2G」は欄の幅を少し超え、PSでは欄の端で
+# 「2G」や先頭の「住」が切れて印字されなかった（VBAは「2G」まで印字）。
+# ・Excelの送り幅に合わせ、全角は1.0em、半角カナは0.507emの固定幅で1文字ずつ並べる（実測：VBA出力の文字位置）。
+#   em（文字の大きさ）は、フォントの設計情報から、描画先(印刷)のGraphicsの単位で求める。
+# ・並べた全体の幅が欄の幅を超える場合は、欄に収まるよう横幅だけを縮めて描画し、文字が欠けないようにする。
+function Get-ExcelAdvanceFactor([char]$c) {
+    $o = [int]$c
+    if ($o -ge 0xFF61 -and $o -le 0xFF9F) { return 0.507 }  # 半角カナ：0.507em
+    if ($o -gt 0x2000) { return 1.0 }                        # 全角：1.0em
+    return 0
+}
+function Test-NeedsExcelAdvance([string]$text) {
+    foreach ($c in $text.ToCharArray()) { if ((Get-ExcelAdvanceFactor $c) -gt 0) { return $true } }
+    return $false
+}
+function Draw-ExcelText {
+    param($Graphics, [string]$Text, $Font, $Brush, [double]$X0, [double]$X1, [double]$Y, [string]$HAlign)
+    $sf = [System.Drawing.StringFormat]::GenericTypographic.Clone()
+    $sf.FormatFlags = $sf.FormatFlags -bor [System.Drawing.StringFormatFlags]::NoWrap -bor [System.Drawing.StringFormatFlags]::NoClip -bor [System.Drawing.StringFormatFlags]::MeasureTrailingSpaces
+    $ff = $Font.FontFamily
+    $em = $Font.GetHeight($Graphics) * $ff.GetEmHeight($Font.Style) / $ff.GetLineSpacing($Font.Style)   # 文字の大きさ(em)
+    $pad = $em / 6           # 従来の描画(既定の書式)が文字列の前後に入れていた余白(1/6 em)
+    $items = New-Object System.Collections.Generic.List[object]
+    $buf = New-Object System.Text.StringBuilder
+    foreach ($c in $Text.ToCharArray()) {
+        $f = Get-ExcelAdvanceFactor $c
+        if ($f -gt 0) {
+            if ($buf.Length -gt 0) {
+                $t = $buf.ToString(); [void]$buf.Clear()
+                $items.Add(@{ T = $t; W = $Graphics.MeasureString($t, $Font, 100000, $sf).Width })
+            }
+            $items.Add(@{ T = [string]$c; W = ($em * $f) })
+        }
+        else { [void]$buf.Append($c) }
+    }
+    if ($buf.Length -gt 0) {
+        $t = $buf.ToString()
+        $items.Add(@{ T = $t; W = $Graphics.MeasureString($t, $Font, 100000, $sf).Width })
+    }
+    $total = 0.0
+    foreach ($it in $items) { $total += $it.W }
+    $avail = ($X1 - $X0) - 6                      # 欄の幅（左右3ずつの余白を除く）
+    $shrink = 1.0
+    if ($total -gt $avail -and $avail -gt 0) { $shrink = $avail / $total }   # 欄からはみ出す文字列は、欄に収まるよう横幅を縮める
+    if ($HAlign -eq "center") { $x = ($X0 + $X1) / 2 - $total / 2; $anchor = ($X0 + $X1) / 2 }
+    elseif ($HAlign -eq "right") { $x = $X1 - 3 - $pad - $total; $anchor = $X1 - 3 - $pad }
+    else { $x = $X0 + 3 + $pad; $anchor = $x }
+    $state = $null
+    if ($shrink -lt 1.0) {
+        $state = $Graphics.Save()
+        $Graphics.TranslateTransform([single]$anchor, 0)
+        $Graphics.ScaleTransform([single]$shrink, 1)
+        $Graphics.TranslateTransform([single](-$anchor), 0)
+    }
+    foreach ($it in $items) {
+        $Graphics.DrawString($it.T, $Font, $Brush, [single]$x, [single]$Y, $sf)
+        $x += $it.W
+    }
+    if ($null -ne $state) { $Graphics.Restore($state) }
+    $sf.Dispose()
+}
