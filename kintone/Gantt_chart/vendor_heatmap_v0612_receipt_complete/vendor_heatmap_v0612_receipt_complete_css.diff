 }
+
+/* =====================================================================
+   Ver0.6.1.2 外注入荷実績記録 + ガント完了表示
+   Ver0.6.0.3 CSSを母体に、入荷操作UI / 完了表示CSSを統合。
+   Claude実コードレビュー指摘: .eh-gantt-info -> .eh-gantt-cell 修正済み。
+   ===================================================================== */
+
+/*
+ * 外注課 外注先負荷ヒートマップ Ver0.6.1.2
+ * 外注入荷実績日 / ガント完了表示 追加CSS
+ *
+ * 前提:
+ *   vendor_heatmap_v0603_standard_gantt_layout.css を変更せず併用する。
+ *   このファイルは完了表示・入荷操作UIに必要なクラスだけを追加する。
+ */
+
+/* ------------------------------------------------------------------
+ * 入荷操作
+ * ------------------------------------------------------------------ */
+.eh-schedule-scroll .eh-receipt-control {
+  margin-top:4px;
+  display:flex;
+  align-items:center;
+  gap:6px;
+  flex-wrap:wrap;
+}
+
+.eh-schedule-scroll .eh-receipt-button,
+.eh-schedule-scroll .eh-receipt-save,
+.eh-schedule-scroll .eh-receipt-cancel {
+  box-sizing:border-box;
+  min-height:24px;
+  padding:2px 8px;
+  border:1px solid #98a2b3;
+  border-radius:4px;
+  background:#fff;
+  color:#344054;
+  font-size:11px;
+  line-height:18px;
+  cursor:pointer;
+  white-space:nowrap;
+}
+
+.eh-schedule-scroll .eh-receipt-button:hover,
+.eh-schedule-scroll .eh-receipt-save:hover,
+.eh-schedule-scroll .eh-receipt-cancel:hover {
+  background:#f2f4f7;
+}
+
+.eh-schedule-scroll .eh-receipt-button:disabled,
+.eh-schedule-scroll .eh-receipt-save:disabled,
+.eh-schedule-scroll .eh-receipt-cancel:disabled,
+.eh-schedule-scroll .eh-receipt-date-input:disabled {
+  cursor:not-allowed;
+  opacity:.55;
+}
+
+.eh-schedule-scroll .eh-receipt-save {
+  border-color:#667085;
+  font-weight:700;
+}
+
+.eh-schedule-scroll .eh-receipt-edit-button {
+  padding-left:6px;
+  padding-right:6px;
+  font-size:10px;
+}
+
+/* ------------------------------------------------------------------
+ * 行内の日付確認UI
+ * ------------------------------------------------------------------ */
+.eh-schedule-scroll .eh-receipt-editor {
+  flex-basis:100%;
+  box-sizing:border-box;
+  margin-top:2px;
+  padding:6px;
+  border:1px solid #d0d5dd;
+  border-radius:5px;
+  background:#fff;
+  box-shadow:0 1px 3px rgba(16,24,40,.08);
+  color:#344054;
+  font-size:11px;
+  line-height:1.35;
+}
+
+.eh-schedule-scroll .eh-receipt-editor-label {
+  display:flex;
+  align-items:center;
+  gap:6px;
+  font-weight:700;
+}
+
+.eh-schedule-scroll .eh-receipt-date-input {
+  box-sizing:border-box;
+  min-width:126px;
+  height:26px;
+  padding:2px 4px;
+  border:1px solid #98a2b3;
+  border-radius:4px;
+  background:#fff;
+  color:#101828;
+  font:inherit;
+}
+
+.eh-schedule-scroll .eh-receipt-due {
+  margin-top:4px;
+  color:#667085;
+}
+
+.eh-schedule-scroll .eh-receipt-warning {
+  min-height:0;
+  margin-top:3px;
+  color:#b54708;
+  font-size:10px;
+}
+
+.eh-schedule-scroll .eh-receipt-warning:empty {
+  display:none;
+}
+
+.eh-schedule-scroll .eh-receipt-editor-actions {
+  display:flex;
+  gap:5px;
+  margin-top:5px;
+}
+
+/* ------------------------------------------------------------------
+ * 入荷済み表示
+ * 既存の髭・太線・マーカーの位置/長さ/DOM構造は変更しない。
+ * ------------------------------------------------------------------ */
+.eh-schedule-scroll .eh-completed .eh-gantt-cell {
+  background:#f2f4f7;
+  color:#667085;
+}
+
+.eh-schedule-scroll .eh-completed .eh-gantt-col-vendor,
+.eh-schedule-scroll .eh-completed .eh-gantt-col-staff,
+.eh-schedule-scroll .eh-completed .eh-dates,
+.eh-schedule-scroll .eh-completed .eh-cell-text {
+  color:#667085;
+}
+
+.eh-schedule-scroll .eh-completed .eh-record-link {
+  color:#667085;
+}
+
+.eh-schedule-scroll .eh-completed .eh-track {
+  background-color:#f8f9fa;
+}
+
+.eh-schedule-scroll .eh-completed .eh-whisker,
+.eh-schedule-scroll .eh-completed .eh-workbar,
+.eh-schedule-scroll .eh-completed .eh-plugin-marker,
+.eh-schedule-scroll .eh-completed .eh-track-weekend,
+.eh-schedule-scroll .eh-completed .eh-track-today {
+  filter:grayscale(1);
+  opacity:.38;
+}
+
+.eh-schedule-scroll .eh-completed .eh-workbar-label {
+  color:#475467;
+}
+
+.eh-schedule-scroll .eh-completed-badge {
+  display:inline-flex;
+  align-items:center;
+  min-height:22px;
+  padding:1px 7px;
+  border:1px solid #cfd4dc;
+  border-radius:999px;
+  background:#e4e7ec;
+  color:#475467;
+  font-size:10px;
+  font-weight:700;
+  line-height:18px;
+  white-space:nowrap;
+}
+
+/* Manual行でも、入荷済みなら「完了」が見た目の主状態。
+ * Mバッジ自体は残して日程由来情報を失わない。 */
+.eh-schedule-scroll .eh-completed.eh-manual-row .eh-gantt-cell {
+  background:#f2f4f7;
+}
+
+/* ホバー/フォーカス時も完了状態が派手に戻らないようにする。 */
+.eh-schedule-scroll .eh-completed:hover .eh-gantt-cell,
+.eh-schedule-scroll .eh-completed:focus-within .eh-gantt-cell {
+  background:#eef0f2;
+}
+
+.eh-schedule-scroll .eh-completed:hover .eh-track,
+.eh-schedule-scroll .eh-completed:focus-within .eh-track {
+  box-shadow:inset 0 0 0 9999px rgba(102,112,133,.035);
+}
