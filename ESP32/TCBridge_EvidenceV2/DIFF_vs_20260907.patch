+
+static size_t buildEvidenceResultFrame(uint8_t* out, size_t capacity) {
+  if (!out || capacity < EVIDENCE_RESULT_FRAME_LEN || !gEvidenceReady.load()) {
+    return 0;
+  }
+
+  size_t pos = 0;
+  auto put8 = [&](uint8_t v) { out[pos++] = v; };
+  auto put32le = [&](uint32_t v) {
+    out[pos++] = (uint8_t)(v & 0xFFu);
+    out[pos++] = (uint8_t)((v >> 8) & 0xFFu);
+    out[pos++] = (uint8_t)((v >> 16) & 0xFFu);
+    out[pos++] = (uint8_t)((v >> 24) & 0xFFu);
+  };
+  auto putPair = [&](uint32_t start, uint32_t end) {
+    put32le(start);
+    put32le(end);
+  };
+
+  for (uint8_t b : EVIDENCE_RESULT_MAGIC) put8(b);
+  put8(EVIDENCE_VERSION);
+  put8(EVIDENCE_PAYLOAD_LEN);
+  put32le(TC_EVIDENCE_DURATION_MS);
+
+  // Fixed counter order from Evidence V2 specification.
+  putPair(gEvidenceStart.pollMaxIntervalUs,      gEvidenceEnd.pollMaxIntervalUs);
+  putPair(gEvidenceStart.pollOver1000Count,      gEvidenceEnd.pollOver1000Count);
+  putPair(gEvidenceStart.c1IsrEdges,              gEvidenceEnd.c1IsrEdges);
+  putPair(gEvidenceStart.c1EdgeOverflow,          gEvidenceEnd.c1EdgeOverflow);
+  putPair(gEvidenceStart.c2DecodedBytes,          gEvidenceEnd.c2DecodedBytes);
+  putPair(gEvidenceStart.c2DecodeErrors,          gEvidenceEnd.c2DecodeErrors);
+  putPair(gEvidenceStart.c2TimingErrors,          gEvidenceEnd.c2TimingErrors);
+  putPair(gEvidenceStart.c2LocalEdgeOverflow,     gEvidenceEnd.c2LocalEdgeOverflow);
+  putPair(gEvidenceStart.c3ValidFrames,           gEvidenceEnd.c3ValidFrames);
+  putPair(gEvidenceStart.c3FrameErrors,           gEvidenceEnd.c3FrameErrors);
+  putPair(gEvidenceStart.c3SyncMisses,            gEvidenceEnd.c3SyncMisses);
+  putPair(gEvidenceStart.c3Resyncs,               gEvidenceEnd.c3Resyncs);
+  putPair(gEvidenceStart.c4QueuedFrames,           gEvidenceEnd.c4QueuedFrames);
+  putPair(gEvidenceStart.c4QueueDrops,             gEvidenceEnd.c4QueueDrops);
+
+  // At this point pos must be 122 (MAGIC..PAYLOAD end).
+  if (pos != EVIDENCE_RESULT_FRAME_LEN - 2) return 0;
+  uint16_t sum = 0;
+  for (size_t i = 0; i < pos; ++i) sum = (uint16_t)(sum + out[i]);
+  out[pos++] = (uint8_t)(sum & 0xFFu);
+  out[pos++] = (uint8_t)((sum >> 8) & 0xFFu);
+  return pos;
+}
